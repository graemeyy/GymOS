// GymOS data model. Money is stored as integer cents in AUD. Prices are
// GST-inclusive; GST is derived (1/11 of an inclusive amount) and stored on
// payment records so reports don't depend on today's rate.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Legacy fixed plan list. Kept so older rows and a rollback still work;
// new code reads Member.planId -> MembershipPlan instead.
enum Plan {
  BASIC
  PREMIUM
  PLATINUM
  ELITE
}

// Database identifiers keep their original spelling; the UI says "Cancelled".
enum Status {
  ACTIVE
  PAUSED
  CANCELED
  PAST_DUE
  // Signed up online but hasn't started a plan yet. No access.
  PENDING
}

enum EquipmentStatus {
  OPERATIONAL
  WARNING
  OFFLINE
}

enum BillingInterval {
  WEEK
  FORTNIGHT
  MONTH
  YEAR
}

model MembershipPlan {
  id                   String          @id @default(cuid())
  slug                 String          @unique
  name                 String
  description          String?
  priceCents           Int
  interval             BillingInterval @default(MONTH)
  stripePriceId        String?         @unique
  active               Boolean         @default(true)
  sortOrder            Int             @default(0)
  // Benefits per billing cycle. A null classCreditsPerCycle means unlimited.
  classCreditsPerCycle Int?
  guestPassesPerCycle  Int             @default(0)
  shopDiscountPercent  Int             @default(0)
  guestRateCents       Int             @default(0)
  // Which locations the plan lets members in at (D-126).
  locationAccess       LocationAccess  @default(ALL)
  locations            PlanLocation[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  members              Member[]        @relation("CurrentPlan")
  pendingFor           Member[]        @relation("PendingPlan")
  announcements        Announcement[]
}

model Member {
  id                   String            @id @default(cuid())
  email                String            @unique
  name                 String?
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  plan                 Plan              @default(BASIC)
  planId               String?
  membershipPlan       MembershipPlan?   @relation("CurrentPlan", fields: [planId], references: [id], onDelete: SetNull)
  // A downgrade or upgrade that takes effect at the next billing date.
  pendingPlanId        String?
  pendingPlan          MembershipPlan?   @relation("PendingPlan", fields: [pendingPlanId], references: [id], onDelete: SetNull)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  pausedFrom           DateTime?
  pausedUntil          DateTime?
  cancelAt             DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  pastDueSince         DateTime?
  amountOwingCents     Int               @default(0)
  lastFailedInvoiceId  String?
  qrVersion            Int               @default(0)
  // Where the member mainly trains (D-125). New rows land at the main
  // location unless one is given.
  homeLocationId       String            @default("main")
  homeLocation         Location          @relation("HomeLocation", fields: [homeLocationId], references: [id], onDelete: Restrict)
  notifyAnnouncements  Boolean           @default(true)
  notifyWaitlist       Boolean           @default(true)
  onboardedAt          DateTime?
  // When the current membership started (first payment or staff activation).
  // Cooling-off and minimum term count from here, not from sign-up (R-07).
  membershipStartedAt  DateTime?
  // Created time of the newest Stripe subscription event applied, so a late,
  // older event can't overwrite newer state (R-08).
  stripeEventAt        DateTime?
  // Set when a member's personal details were erased on request. The row
  // stays so payments (kept for tax) still have an owner.
  anonymisedAt         DateTime?
  status               Status            @default(ACTIVE)
  keycardIssued        Boolean           @default(false)
  lastCheckIn          DateTime?
  retentionScore       Int               @default(100)
  notes                String?
  passwordHash         String?
  // Set on seeded accounts: the password must be changed at the next
  // sign-in before anything else works (D-111).
  mustChangePassword   Boolean           @default(false)
  // When the member proved they receive email at this address. Online
  // sign-ups start unverified; see D-114 for what that limits.
  emailVerifiedAt      DateTime?
  sessionVersion       Int               @default(0)
  archivedAt           DateTime?
  referredById         String?
  referredBy           Member?           @relation("MemberReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals            Member[]          @relation("MemberReferrals")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  checkIns             CheckIn[]
  payments             Payment[]
  classBookings        ClassBooking[]
  classWaitlist        ClassWaitlist[]
  memberNotes          MemberNote[]
  ledger               BenefitLedger[]
  events               MembershipEvent[]
  orders               Order[]
  reminders            PaymentReminder[]
  legalAcceptances     LegalAcceptance[]
  authTokens           AuthToken[]

  @@index([status])
  @@index([planId])
  @@index([referredById])
  @@index([createdAt])
  @@index([cancelledAt])
}

// Staff notes about a member, with who wrote them. Staff-only.
model MemberNote {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  staffId   String?
  staffName String
  body      String
  createdAt DateTime @default(now())

  @@index([memberId, createdAt])
}

enum LedgerKind {
  CLASS_CREDIT
  GUEST_PASS
  ACCOUNT_CREDIT
}

// Every change to a member's class credits, guest passes or account credit:
// manual adjustments by staff, credits used by bookings, credits returned on
// cancellation. Balances for the current cycle are the plan allowance plus
// the sum of entries since the cycle started.
model BenefitLedger {
  id          String     @id @default(cuid())
  memberId    String
  member      Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind        LedgerKind
  delta       Int
  reason      String
  refType     String?
  refId       String?
  staffId     String?
  createdAt   DateTime   @default(now())
  // The moment the entry counts towards: a class credit belongs to the cycle
  // of the class it was used for, not the day it was booked (R-04).
  effectiveAt DateTime   @default(now())

  @@index([memberId, kind, createdAt])
  @@index([memberId, kind, effectiveAt])
}

enum MembershipEventType {
  JOINED
  PLAN_CHANGED
  PLAN_CHANGE_SCHEDULED
  PAUSE_SCHEDULED
  RESUMED
  CANCEL_REQUESTED
  CANCEL_WITHDRAWN
  CANCELLED
}

model MembershipEvent {
  id          String              @id @default(cuid())
  memberId    String
  member      Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type        MembershipEventType
  effectiveAt DateTime            @default(now())
  details     Json?
  actorName   String
  createdAt   DateTime            @default(now())

  @@index([memberId, createdAt])
  @@index([type, effectiveAt])
}

// One reminder per member, per overdue episode, per reminder day.
model PaymentReminder {
  id           String   @id @default(cuid())
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pastDueSince DateTime
  day          Int
  sentAt       DateTime @default(now())

  @@unique([memberId, pastDueSince, day])
}

model CheckIn {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id])
  location   String   @default("Main Entrance")
  locationId String   @default("main")
  site       Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  method     String   @default("MANUAL")
  timestamp  DateTime @default(now())

  @@index([memberId, timestamp])
  @@index([timestamp])
  @@index([locationId, timestamp])
}

// Money received from a member. The table is still called "Payout" in the
// database (the original, misleading name); @@map keeps that without a rename.
model Payment {
  id                    String      @id @default(cuid())
  memberId              String
  member                Member      @relation(fields: [memberId], references: [id])
  amount                Int
  gstCents              Int         @default(0)
  currency              String      @default("aud")
  status                String
  stripeInvoiceId       String?     @unique
  stripePaymentIntentId String?     @unique
  description           String?
  // The location the money is reported under (D-129): the member's home
  // location for memberships, the order's location for the shop.
  locationId            String      @default("main")
  location              Location    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  kind                  PaymentKind @default(MEMBERSHIP)
  // Sequential tax invoice number, assigned by the database.
  invoiceNumber         Int         @unique @default(autoincrement())
  refundedCents         Int         @default(0)
  planName              String?
  orderId               String?     @unique
  order                 Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt             DateTime    @default(now())
  // When the money was actually paid. Webhooks can arrive late, so tax
  // invoices and finance periods use this, not createdAt (R-23).
  paidAt                DateTime    @default(now())
  refunds               Refund[]

  @@index([createdAt])
  @@index([paidAt])
  @@index([memberId, createdAt])
  @@index([locationId, paidAt])
  @@map("Payout")
}

enum PaymentKind {
  MEMBERSHIP
  SHOP
  OTHER
}

model Refund {
  id             String    @id @default(cuid())
  paymentId      String
  payment        Payment   @relation(fields: [paymentId], references: [id])
  amountCents    Int
  gstCents       Int
  reason         String
  stripeRefundId String?   @unique
  // MANUAL refunds were paid back outside Stripe (cash, bank transfer).
  method         String    @default("STRIPE")
  staffId        String?
  staffName      String
  createdAt      DateTime  @default(now())
  // Set when Stripe reports the refund failed or was cancelled after it was
  // recorded: the money never reached the customer, so the refund no longer
  // counts towards the payment or the finance reports (R-25, D-116).
  failedAt       DateTime?
  failureReason  String?

  @@index([createdAt])
  @@index([paymentId])
}

model Equipment {
  id                   String          @id @default(cuid())
  name                 String
  serialNumber         String?         @unique
  status               EquipmentStatus @default(OPERATIONAL)
  healthScore          Float           @default(1.0)
  failureProbability   Float           @default(0.0)
  lastServicedAt       DateTime?
  predictedFailureDate DateTime?
  partNeeded           String?
  estimatedCost        Int?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Approval queue. Currently used for equipment purchase orders.
model AgentAction {
  id          String       @id @default(cuid())
  title       String
  description String
  status      ActionStatus @default(PENDING)
  category    String
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Class {
  id              String          @id @default(cuid())
  name            String
  instructor      String?
  trainerId       String?
  trainer         Staff?          @relation("ClassTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  templateId      String?
  template        ClassTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  startTime       DateTime
  durationMinutes Int             @default(45)
  capacity        Int             @default(20)
  locationId      String          @default("main")
  location        Location        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  // Cancelled classes stay as rows so the daily timetable job doesn't
  // recreate them (R-05).
  cancelledAt     DateTime?
  bookings        ClassBooking[]
  waitlist        ClassWaitlist[]

  @@unique([templateId, startTime])
  @@index([startTime])
  @@index([trainerId, startTime])
  @@index([locationId, startTime])
}

// A weekly timetable slot. "Generate" turns templates into dated classes.
model ClassTemplate {
  id              String   @id @default(cuid())
  name            String
  trainerId       String?
  trainer         Staff?   @relation("TemplateTrainer", fields: [trainerId], references: [id], onDelete: SetNull)
  // 0 = Monday ... 6 = Sunday, in the gym's timezone.
  weekday         Int
  startTime       String
  durationMinutes Int      @default(45)
  capacity        Int      @default(16)
  locationId      String   @default("main")
  location        Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  classes         Class[]
}

enum BookingStatus {
  BOOKED
  ATTENDED
  NO_SHOW
}

model ClassBooking {
  id         String        @id @default(cuid())
  classId    String
  class      Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member        @relation(fields: [memberId], references: [id])
  status     BookingStatus @default(BOOKED)
  // True when this booking used one of the member's class credits.
  usedCredit Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@unique([classId, memberId])
  @@index([memberId])
}

model ClassWaitlist {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  createdAt DateTime @default(now())

  @@unique([classId, memberId])
  @@index([memberId])
}

// Legacy: monthly price per enum plan. Superseded by MembershipPlan.priceCents.
model PlanPrice {
  plan       Plan     @id
  priceCents Int
  updatedAt  DateTime @updatedAt
}

// Legacy: gym details now live in config/gym.config.json.
model GymProfile {
  id       String  @id @default("singleton")
  gymName  String  @default("GymOS")
  address  String?
  timezone String  @default("America/New_York")
}

model GymSettings {
  id                       String  @id @default("singleton")
  requireKeycardForEntry   Boolean @default(false)
  hideRevenueFromFrontDesk Boolean @default(false)
}

// The gym's branding (D-124). One row. Every column is optional: empty means
// the default from config/gym.config.json, so a new copy looks right before
// anyone opens the Branding page.
model Branding {
  id              String    @id @default("singleton")
  name            String?
  appName         String?
  tagline         String?
  logoText        String?
  primaryColour   String?
  accentColour    String?
  bodyFont        String?
  displayFont     String?
  emailSenderName String?
  emailFooter     String?
  legalName       String?
  abn             String?
  contactEmail    String?
  contactPhone    String?
  addressLine1    String?
  addressLine2    String?
  suburb          String?
  state           String?
  postcode        String?
  // Uploaded images, small enough to keep in the row (at most 256 KB each).
  logoData        Bytes?
  logoType        String?
  iconData        Bytes?
  updatedAt       DateTime  @updatedAt
  imagesUpdatedAt DateTime?
}

enum LocationAccess {
  HOME
  SELECTED
  ALL
}

// One site of the gym (D-125). Every gym has the "main" location from the
// migration; a chain adds more. Rows that belong somewhere (classes, shifts,
// check-ins, orders, stock) default to "main".
model Location {
  id            String          @id @default(cuid())
  name          String          @unique
  // Short and stable: door gateways and kiosks send it.
  code          String          @unique
  addressLine1  String          @default("")
  addressLine2  String          @default("")
  suburb        String          @default("")
  state         String          @default("")
  postcode      String          @default("")
  phone         String?
  sortOrder     Int             @default(0)
  archivedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  members       Member[]        @relation("HomeLocation")
  checkIns      CheckIn[]
  classes       Class[]
  templates     ClassTemplate[]
  shifts        Shift[]
  orders        Order[]
  announcements Announcement[]
  plans         PlanLocation[]
  staff         StaffLocation[]
  stock         VariantStock[]
  payments      Payment[]
}

model PlanLocation {
  planId     String
  plan       MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  locationId String
  location   Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([planId, locationId])
}

model StaffLocation {
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([staffId, locationId])
}

model VariantStock {
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String
  location   Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Int            @default(0)

  @@id([variantId, locationId])
  @@index([locationId])
}

model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  category      String?
  sku           String?  @unique
  quantity      Int      @default(0)
  reorderLevel  Int      @default(0)
  unitCostCents Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum StaffRole {
  OWNER
  MANAGER
  FRONT_DESK
  TRAINER
}

model Staff {
  id                 String          @id @default(cuid())
  email              String          @unique
  name               String
  // Null until an invited person sets their password.
  passwordHash       String?
  // Legacy fixed role, kept for rollback; access comes from roleId (D-098).
  role               StaffRole       @default(FRONT_DESK)
  roleId             String?
  // The locations this person's role applies at; none means every location
  // (D-128).
  locations          StaffLocation[]
  assignedRole       Role?           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  deactivatedAt      DateTime?
  inviteTokenHash    String?         @unique
  inviteExpiresAt    DateTime?
  // Set on seeded and newly invited accounts: the password must be changed
  // before anything else works. Accepting an invitation counts (D-111).
  mustChangePassword Boolean         @default(false)
  sessionVersion     Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  auditLogs          AuditLog[]
  shifts             Shift[]
  classes            Class[]         @relation("ClassTrainer")
  templates          ClassTemplate[] @relation("TemplateTrainer")
  announcements      Announcement[]
  authTokens         AuthToken[]

  @@index([roleId])
}

// A named set of permissions. Five presets are created by the migration;
// people with roles.manage can edit them (except Owner) and add custom roles.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  // OWNER, ADMIN, MANAGER, STAFF or TRAINER for the presets; null for custom roles.
  preset      String?  @unique
  // Owners can do everything, including the owner-only actions.
  isOwner     Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  staff       Staff[]
}

model Shift {
  id         String   @id @default(cuid())
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startTime  DateTime
  endTime    DateTime
  notes      String?
  locationId String   @default("main")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@index([startTime])
  @@index([locationId, startTime])
}

model AuditLog {
  id         String   @id @default(cuid())
  staffId    String?
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffName  String
  action     String
  targetType String
  targetId   String?
  details    Json?
  // Old and new values for changes to prices, plans, products, settings,
  // roles, staff accounts and refunds.
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@index([staffId])
}

// Stripe event IDs already processed, so webhook retries are no-ops.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// Fixed-window rate limit counters, shared across serverless instances.
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)
}

enum ProductCategory {
  APPAREL
  SUPPLEMENTS
  ACCESSORIES
  OTHER
}

model Product {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String?
  category    ProductCategory
  imageUrl    String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
}

model ProductVariant {
  id         String         @id @default(cuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String?
  colour     String?
  flavour    String?
  sku        String         @unique
  priceCents Int
  stockQty   Int            @default(0)
  // Stock per location (D-127). stockQty above is the pre-locations column,
  // kept for rollback and no longer read.
  stock      VariantStock[]
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  orderItems OrderItem[]

  @@index([productId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PACKED
  READY_FOR_PICKUP
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum Fulfilment {
  PICKUP
  SHIPPING
}

model Order {
  id                      String       @id @default(cuid())
  number                  Int          @unique @default(autoincrement())
  memberId                String?
  member                  Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  email                   String
  customerName            String
  status                  OrderStatus  @default(PENDING_PAYMENT)
  fulfilment              Fulfilment   @default(PICKUP)
  // Where it's collected from, or shipped from: its stock comes from here.
  locationId              String       @default("main")
  location                Location     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  subtotalCents           Int
  discountCents           Int          @default(0)
  shippingCents           Int          @default(0)
  totalCents              Int
  gstCents                Int
  discountPercent         Int          @default(0)
  shippingAddress         Json?
  trackingNumber          String?
  stripeCheckoutSessionId String?      @unique
  stockCommitted          Boolean      @default(false)
  confirmationSentAt      DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  paidAt                  DateTime?
  items                   OrderItem[]
  events                  OrderEvent[]
  payment                 Payment?

  @@index([status, createdAt])
  @@index([memberId, createdAt])
  @@index([paidAt])
  @@index([locationId, status])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant  @relation(fields: [variantId], references: [id])
  productName    String
  variantLabel   String
  category       ProductCategory
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  @@index([orderId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorName String
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

enum AnnouncementAudience {
  ALL_ACTIVE
  PLAN
  STAFF_ONLY
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String
  audience    AnnouncementAudience @default(ALL_ACTIVE)
  planId      String?
  // Null for every location; otherwise members whose home location this is.
  locationId  String?
  location    Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  plan        MembershipPlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  expiresAt   DateTime?
  emailedAt   DateTime?
  emailCount  Int                  @default(0)
  createdById String?
  createdBy   Staff?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([publishedAt])
}

enum LegalDocument {
  TERMS
  PRIVACY
}

// Which version of the terms or privacy policy a member accepted, and when.
// Kept if the member is anonymised (memberId is then still set, but the
// member row holds no personal details).
model LegalAcceptance {
  id         String        @id @default(cuid())
  memberId   String
  member     Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  document   LegalDocument
  version    String
  context    String
  acceptedAt DateTime      @default(now())

  @@index([memberId, document, acceptedAt])
}

enum AuthTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

// Single-use links sent by email: password resets and email verification
// (D-112, D-113). Only a SHA-256 hash of the token is stored; the token
// itself exists only in the email.
model AuthToken {
  id        String           @id @default(cuid())
  tokenHash String           @unique
  purpose   AuthTokenPurpose
  staffId   String?
  staff     Staff?           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  memberId  String?
  member    Member?          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // The address the link was sent to, so verifying confirms that address.
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([staffId, purpose])
  @@index([memberId, purpose])
}
