// Deployment Trigger: Linking Vercel Postgres and DATABASE_URL verified.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  BASIC
  PREMIUM
  PLATINUM
  ELITE
}

enum Status {
  ACTIVE
  PAUSED
  CANCELED
  PAST_DUE
}

enum EquipmentStatus {
  OPERATIONAL
  WARNING
  OFFLINE
}

model Member {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  stripeCustomerId String?   @unique
  stripeSubscriptionId String? @unique
  plan             Plan      @default(BASIC)
  status           Status    @default(ACTIVE)
  keycardIssued    Boolean   @default(false)
  lastCheckIn      DateTime?
  retentionScore   Int       @default(100)
  notes            String?
  referredById     String?
  referredBy       Member?   @relation("MemberReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        Member[]  @relation("MemberReferrals")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  checkIns         CheckIn[]
  payouts          Payout[]
  classBookings    ClassBooking[]
  classWaitlist    ClassWaitlist[]
}

model CheckIn {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  location  String   @default("Main Entrance")
  timestamp DateTime @default(now())
}

model Payout {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  amount    Int
  currency  String   @default("usd")
  status    String
  createdAt DateTime @default(now())
}

model Equipment {
  id                  String          @id @default(cuid())
  name                String
  serialNumber        String?         @unique
  status              EquipmentStatus @default(OPERATIONAL)
  healthScore         Float           @default(1.0)
  failureProbability  Float           @default(0.0)
  lastServicedAt      DateTime?
  predictedFailureDate DateTime?
  partNeeded          String?
  estimatedCost       Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @default(now()) @updatedAt
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
}

model AgentAction {
  id          String       @id @default(cuid())
  title       String
  description String
  status      ActionStatus @default(PENDING)
  category    String
  metadata    Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Class {
  id              String         @id @default(cuid())
  name            String
  instructor      String?
  startTime       DateTime
  durationMinutes Int            @default(45)
  capacity        Int            @default(20)
  createdAt       DateTime       @default(now())
  bookings        ClassBooking[]
  waitlist        ClassWaitlist[]
}

enum BookingStatus {
  BOOKED
  ATTENDED
  NO_SHOW
}

model ClassBooking {
  id        String        @id @default(cuid())
  classId   String
  class     Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member        @relation(fields: [memberId], references: [id])
  status    BookingStatus @default(BOOKED)
  createdAt DateTime      @default(now())

  @@unique([classId, memberId])
}

model ClassWaitlist {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  createdAt DateTime @default(now())

  @@unique([classId, memberId])
}

model PlanPrice {
  plan      Plan     @id
  priceCents Int
  updatedAt DateTime @updatedAt
}

model GymProfile {
  id       String  @id @default("singleton")
  gymName  String  @default("GymOS")
  address  String?
  timezone String  @default("America/New_York")
}

model GymSettings {
  id                       String  @id @default("singleton")
  requireKeycardForEntry   Boolean @default(false)
  hideRevenueFromFrontDesk Boolean @default(false)
}

model InventoryItem {
  id            String   @id @default(cuid())
  name          String
  category      String?
  sku           String?  @unique
  quantity      Int      @default(0)
  reorderLevel  Int      @default(0)
  unitCostCents Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum StaffRole {
  OWNER
  MANAGER
  FRONT_DESK
}

model Staff {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         StaffRole @default(FRONT_DESK)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditLogs    AuditLog[]
  shifts       Shift[]
}

model Shift {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  notes     String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  staffId    String?
  staff      Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffName  String
  action     String
  targetType String
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())
}
