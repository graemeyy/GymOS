# Copy to .env for local development. Every value here is a placeholder.
# Never commit .env. Production values live in the hosting provider's
# settings, not in this repository.

# Required -----------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL=postgresql://gymos:gymos@localhost:5432/gymos_dev

# Signs session cookies and QR passes. At least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Public URL of the app, used for Stripe redirect links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payments (optional; Stripe TEST MODE only) --------------------------------
# Without these the app runs and payment actions answer "not set up yet".
# Use keys from the Stripe dashboard with "Test mode" switched on.
# Live keys (sk_live_...) are refused unless STRIPE_ALLOW_LIVE_KEYS=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE_KEYS=false

# Machine callers (optional) -------------------------------------------------
# Each endpoint refuses every request until its secret is set (16+ chars).
# Vercel cron sends CRON_SECRET automatically when it's set in the project.
CRON_SECRET=
IOT_GATEWAY_SECRET=

# Email (optional) -----------------------------------------------------------
# Without RESEND_API_KEY, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM="Ironbark Strength Co. <hello@ironbark.example>"

# Vercel only: let preview builds run migrations. Set only if previews use their own database.
# ALLOW_PREVIEW_MIGRATIONS=true
