# Copy to .env for local development. Every value here is a placeholder.
# Never commit .env. Production values live in the hosting provider's
# settings, not in this repository.

# Required -----------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL=postgresql://gymos:gymos@localhost:5432/gymos_dev

# Signs session cookies and QR passes. At least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Public URL of the app, for links in emails, invitations and Stripe
# redirects. Optional: without it, Vercel deployments use their own URL
# (the production domain on production, the deployment's address on
# previews) and local development uses http://localhost:3000.
# NEXT_PUBLIC_APP_URL=https://gym.example.com

# Payments (optional; Stripe TEST MODE only) --------------------------------
# Without these the app runs and payment actions answer "not set up yet".
# Use keys from the Stripe dashboard with "Test mode" switched on.
# Live keys (sk_live_...) are refused unless STRIPE_ALLOW_LIVE_KEYS=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE_KEYS=false

# Machine callers (optional) -------------------------------------------------
# Each endpoint refuses every request until its secret is set (16+ chars).
# Vercel cron sends CRON_SECRET automatically when it's set in the project.
CRON_SECRET=
IOT_GATEWAY_SECRET=

# Email (optional) -----------------------------------------------------------
# Without RESEND_API_KEY, emails are logged instead of sent, and password reset
# and email confirmation links are shown on screen in development and on
# previews (never on production). A local production build can opt in with
# SHOW_EMAIL_LINKS=true.
# SHOW_EMAIL_LINKS=true
RESEND_API_KEY=
EMAIL_FROM="Ironbark Strength Co. <hello@ironbark.example>"

# Vercel only: let preview builds run migrations. Set only if previews use their own database.
# ALLOW_PREVIEW_MIGRATIONS=true

# Required on a production deployment to create the first owner account at /admin/setup.
# Generate with: openssl rand -base64 24
SETUP_TOKEN=

# --- Tests and local checks only (never set these on a deployment) ---
# Each database name must contain "test"; the suites wipe them.
# TEST_DATABASE_URL=postgresql://gymos:gymos@localhost:5432/gymos_test
# E2E_DATABASE_URL=postgresql://gymos:gymos@localhost:5432/gymos_e2e_test
# ROLLBACK_DATABASE_URL=postgresql://gymos:gymos@localhost:5432/gymos_rollback_test
# Use a Chromium that's already installed instead of Playwright's download.
# PLAYWRIGHT_CHROMIUM_PATH=/path/to/chromium
# Set by the host, not by you: VERCEL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA, CI.

# Local seeding only: the password for every demo account `npm run db:seed`
# creates. Leave it unset to get a random one, printed once in your terminal.
# Seeded accounts must change it at first sign-in.
# SEED_DEMO_PASSWORD=
